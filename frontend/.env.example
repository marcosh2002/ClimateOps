# Frontend Environment Variables
# Copy this to .env.local and fill in your values

# API Configuration
# The API URL may include the deployed /api prefix; frontend routes are joined without duplicating it.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# WebSocket URL may also include /api; the client appends the incident stream route.

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_SIMULATION_MODE=true
NEXT_PUBLIC_DEBUG=false